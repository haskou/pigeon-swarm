+static turnports *turnipports_find_udp(turnipports *tp, const ioa_addr *socket_addr) {
+  ioa_addr address;
+  ur_addr_map_value_type value = 0;
+  addr_cpy(&address, socket_addr);
+  addr_set_port(&address, 0);
+  ur_addr_map_get(&(tp->ip_to_turnports_udp), &address, &value);
+  return (turnports *)value;
+}
+
+void turnipports_mark_bound_udp(turnipports *tp, const ioa_addr *socket_addr) {
+  if (tp && socket_addr) {
+    TURN_MUTEX_LOCK(&(tp->mutex));
+    turnports *ports = turnipports_find_udp(tp, socket_addr);
+    const uint16_t port = addr_get_port(socket_addr);
+    if (ports && turnports_is_allocated(ports, port)) {
+      ports->bound_udp[port] = 1;
+    }
+    TURN_MUTEX_UNLOCK(&(tp->mutex));
+  }
+}
+
+int turnipports_has_udp_relay_addr(turnipports *tp, const ioa_addr *socket_addr) {
+  int found = 0;
+  if (tp && socket_addr) {
+    TURN_MUTEX_LOCK(&(tp->mutex));
+    found = turnipports_find_udp(tp, socket_addr) != NULL;
+    TURN_MUTEX_UNLOCK(&(tp->mutex));
+  }
+  return found;
+}
+
+int turnipports_lock_bound_udp(turnipports *tp, const ioa_addr *socket_addr) {
+  if (tp && socket_addr) {
+    TURN_MUTEX_LOCK(&(tp->mutex));
+    turnports *ports = turnipports_find_udp(tp, socket_addr);
+    if (ports && ports->bound_udp[addr_get_port(socket_addr)]) {
+      return 1;
+    }
+    TURN_MUTEX_UNLOCK(&(tp->mutex));
+  }
+  return 0;
+}
+
+void turnipports_unlock_bound_udp(turnipports *tp) {
+  TURN_MUTEX_UNLOCK(&(tp->mutex));
+}
