{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lease-retirement-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopeId",
    "headHash",
    "grantHash",
    "signerKey",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "headHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "grantHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "signerKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
