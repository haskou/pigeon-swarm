{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private acknowledgement batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mailboxId",
    "deliveryIds"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mailboxId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "deliveryIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
      }
    }
  }
}
