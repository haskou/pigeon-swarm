{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "freshness-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopeId",
    "nonce",
    "expectedRevision",
    "expectedHeadHash",
    "batchCommitment"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedHeadHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "batchCommitment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  }
}
