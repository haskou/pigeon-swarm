{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipient-protected MLS frame v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mlsMessage",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mlsMessage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 4,
          "maxLength": 240000
        },
        "kind": {
          "const": "mls-application"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mlsMessage",
        "kind",
        "authorization"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mlsMessage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 4,
          "maxLength": 240000
        },
        "kind": {
          "const": "mls-commit"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scopeId",
            "revision",
            "parentHeadHash",
            "mlsEpoch",
            "mlsMessageHash",
            "policyHash",
            "signatures",
            "headHash",
            "mlsContextHash"
          ],
          "properties": {
            "scopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parentHeadHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "mlsEpoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mlsMessageHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "policyHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "signatures": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 128,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{86}$"
              }
            },
            "headHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "mlsContextHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mlsMessage",
        "kind",
        "authorization"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mlsMessage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 4,
          "maxLength": 240000
        },
        "kind": {
          "const": "mls-welcome"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scopeId",
            "revision",
            "parentHeadHash",
            "mlsEpoch",
            "mlsMessageHash",
            "policyHash",
            "signatures",
            "headHash",
            "mlsContextHash"
          ],
          "properties": {
            "scopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parentHeadHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "mlsEpoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mlsMessageHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "policyHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "signatures": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 128,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{86}$"
              }
            },
            "headHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "mlsContextHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    }
  ]
}
