{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decrypted private operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operationId",
    "scopeId",
    "authorizationRevision",
    "authorDeviceKey",
    "kind",
    "previousOperationIds",
    "payload",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "authorizationRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authorDeviceKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "kind": {
      "enum": [
        "message.create",
        "message.edit",
        "message.delete",
        "reaction.set",
        "receipt.advance",
        "call.signal",
        "membership.propose",
        "membership.commit",
        "device.revoke",
        "presence.update"
      ]
    },
    "previousOperationIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{22}$"
      }
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "presence.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sequence",
              "sentAt",
              "expiresAt"
            ],
            "properties": {
              "status": {
                "enum": [
                  "online",
                  "away",
                  "busy",
                  "offline"
                ]
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sentAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "expiresAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "customMessage": {
                "type": "string",
                "maxLength": 140
              }
            }
          }
        }
      }
    }
  ]
}
