{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "freshness-proof-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopeId",
    "nonce",
    "revision",
    "headHash",
    "batchCommitment",
    "signerKey",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "batchCommitment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "signerKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
