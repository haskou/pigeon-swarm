---
import { getImage, Image } from "astro:assets";

import desktopScreenshot from "../assets/docs/landing-desktop-call-one-camera.png";
import logo from "../assets/docs/logo.png";
import mobileScreenshot from "../assets/docs/landing-mobile-iphone14promax-online.png";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/haskou/pigeon-swarm";
const docs = `${repo}/blob/main/docs`;

const title = "Pigeon Swarm · The self-hosted alternative to Discord";
const description =
  "Channels, direct messages, voice calls and file sharing on a peer-to-peer network your community runs. No phone number, no email, no central account. Public alpha.";

const ogImage = await getImage({ src: desktopScreenshot, width: 1200, format: "jpeg", quality: 82 });
const siteUrl = new URL(base, Astro.site).href;
const ogImageUrl = new URL(ogImage.src, Astro.site).href;

const features = [
  {
    title: "Communities with channels",
    text: "Text and voice channels, roles, invitations, moderation log and pinned messages.",
  },
  {
    title: "Direct messages and groups",
    text: "One-to-one and group conversations with replies, threads, reactions and polls.",
  },
  {
    title: "Voice, video and screen sharing",
    text: "Calls in DMs and voice channels, with noise cancellation and a bundled TURN server.",
  },
  {
    title: "Files, images and stickers",
    text: "Attachments, previews, sticker packs and link previews inside the conversation.",
  },
  {
    title: "Desktop and mobile",
    text: "A browser app you can install on your phone or computer. Nothing to download from a store.",
  },
  {
    title: "Portable identity",
    text: "Your keys are yours, not the node's. Open your identity from another node of your network with your password and recovery key.",
  },
];

const operatorSees = [
  ["Who talks to whom", "Conversation participants, message authors and recipients, reply links and timestamps."],
  ["Community structure", "Members, roles, bans, channels, invitations and moderation entries."],
  ["Call history", "Who called whom, who joined and when."],
  ["Presence", "Online status, custom status and which node you are connected to."],
  ["Attachment details", "File names, types and sizes, and who uploaded them."],
  ["Activity", "Reactions, read markers and, if you enable them, push notification endpoints."],
];

const operatorCannotSee = [
  "The content of direct messages and private community channels: it is encrypted on your device.",
  "Your password and private keys: they never leave your device.",
  "Traffic of a private network, unless the node belongs to it: it is encrypted with the network key.",
];

const comparisonRows = [
  {
    label: "Who runs the servers",
    values: ["Your community, as peer-to-peer nodes", "Discord Inc.", "Any homeserver operator (federated)", "Signal"],
  },
  {
    label: "What you need to sign up",
    values: ["Name, username and password", "Email, sometimes a phone number", "Depends on the homeserver", "A phone number"],
  },
  {
    label: "End-to-end encrypted messages",
    values: ["Direct messages and private communities", "No, for text messages", "Private rooms and DMs by default", "All messages and calls"],
  },
  {
    label: "Channels, roles and voice rooms",
    values: ["Yes", "Yes", "Rooms and spaces", "Groups only"],
  },
  {
    label: "Metadata the operator can see",
    values: ["Social graph and activity (see below)", "Everything the service stores", "Room membership and timing", "Minimal by design"],
  },
  {
    label: "Maturity",
    values: ["Public alpha", "Mature", "Mature", "Mature"],
  },
];

const validations = [
  {
    title: "Relay discovery and recovery",
    text: "Three application nodes form a private network with no manual relay addresses. They must find each other, recover after closed links and restarts, and reconnect while the public directory is blocked.",
    href: `${docs}/RELAY_DISCOVERY_VALIDATION.md`,
  },
  {
    title: "Two nodes, two browsers",
    text: "Two isolated nodes with their own TURN servers. Users register, message, join communities, call, rejoin voice and recover sessions through the real interface.",
    href: `${docs}/TWO_NODE_CALL_VALIDATION.md`,
  },
  {
    title: "Calls across two NAT routers",
    text: "The complete browser workflow runs with each node behind its own simulated NAT router, forcing media through TURN.",
    href: `${docs}/NAT_CALL_VALIDATION.md`,
  },
];

const faqs = [
  {
    question: "Is it ready for my community?",
    answer:
      "It is a public alpha. Most features work, but expect bugs, breaking changes and occasional data migrations. Keep another way to reach your members for now.",
  },
  {
    question: "Can the people running nodes read my messages?",
    answer:
      "Not the content of direct messages or private community channels. They can see metadata: who talks to whom and when, community membership, call history and presence. Public community channels are plaintext and searchable by design.",
  },
  {
    question: "What happens if my node goes offline?",
    answer:
      "Nodes in the same network replicate its data. Open your identity from another node of that network with your password and recovery key, and continue where you left off.",
  },
  {
    question: "What is the difference between a public and a private network?",
    answer:
      "A public network can be discovered and joined openly. A private network requires its key, so unknown nodes cannot join or read its traffic. Communities inside a network can also be public or private.",
  },
  {
    question: "Do I need to configure TURN or relays by hand?",
    answer:
      "No. The bundled TURN server generates and keeps its own secret. Private-network relays discover each other automatically. For calls and relaying over the internet you still need to publish the ports described in the deployment guide.",
  },
  {
    question: "Does it need a phone number or an email?",
    answer:
      "No. You choose a name, a username and a password. The app also gives you a recovery key; keep it safe, because there is no central account to reset.",
  },
  {
    question: "Can I use it commercially?",
    answer:
      "The source is published under the PolyForm Noncommercial 1.0.0 license. Commercial use needs a separate license from the author.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta name="theme-color" content="#111328" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta property="og:image:alt" content="Pigeon Swarm desktop interface with channels, a conversation and a voice call" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/x-icon" href={`${base}favicon/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}favicon/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}favicon/site.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="#top">
        <Image src={logo} alt="" width={36} height={36} densities={[1, 2]} format="webp" loading="eager" />
        <span>Pigeon Swarm</span>
      </a>
      <nav aria-label="Main">
        <ul class="nav-links">
          <li><a href="#features">Features</a></li>
          <li><a href="#privacy">Privacy</a></li>
          <li><a href="#compare">Compare</a></li>
          <li><a href="#self-host">Self-host</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </nav>
      <a class="nav-github" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <p class="badge">Public alpha</p>
        <h1 id="hero-title">The self-hosted alternative to Discord.</h1>
        <p class="lead">
          Channels, direct messages, voice calls and file sharing on a peer-to-peer network that your community runs.
          No phone number, no email, no central account.
        </p>
        <div class="actions">
          <a class="button button-primary" href="#self-host">Run a node</a>
          <a class="button" href={repo}>Read the source</a>
        </div>
        <figure class="hero-shot">
          <Image
            src={desktopScreenshot}
            alt="Pigeon Swarm desktop interface with community channels, a conversation, the member list and an active voice call"
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1220px) 1160px, calc(100vw - 32px)"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </section>

      <section id="features" class="section" aria-labelledby="features-title">
        <div class="section-heading">
          <h2 id="features-title">Everything a community chat needs.</h2>
          <p>
            Familiar if you come from Discord, with one difference: the servers belong to the people who use them.
          </p>
        </div>
        <div class="features-layout">
          <ul class="feature-grid">
            {features.map((feature) => (
              <li class="card">
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </li>
            ))}
          </ul>
          <figure class="phone">
            <Image
              src={mobileScreenshot}
              alt="Pigeon Swarm on a phone, showing a channel conversation"
              width={300}
              densities={[1, 1.5]}
              format="webp"
              quality={80}
            />
          </figure>
        </div>
      </section>

      <section id="network" class="section" aria-labelledby="network-title">
        <div class="section-heading">
          <h2 id="network-title">No single server to lose.</h2>
          <p>
            Every node in a network keeps a copy of that network's data. If the node you use goes down, open your
            identity from another one with your password and recovery key.
          </p>
        </div>
        <ol class="steps">
          <li class="card">
            <span class="step-number">1</span>
            <h3>Run or join a node</h3>
            <p>One Docker image contains the app, the node and its storage. No external database.</p>
          </li>
          <li class="card">
            <span class="step-number">2</span>
            <h3>Choose a network</h3>
            <p>Join the public network, or create a private one that only nodes with its key can enter.</p>
          </li>
          <li class="card">
            <span class="step-number">3</span>
            <h3>Nodes replicate</h3>
            <p>Communities, messages and profiles are copied between the nodes of that network.</p>
          </li>
        </ol>
      </section>

      <section id="privacy" class="section" aria-labelledby="privacy-title">
        <div class="section-heading">
          <h2 id="privacy-title">What a node operator can and cannot see.</h2>
          <p>
            Message content in private conversations is end-to-end encrypted, but the network still needs metadata to
            deliver it. Anyone running a node in your network can inspect the replicated data below. Pick your networks
            accordingly.
          </p>
        </div>
        <div class="privacy-grid">
          <div class="card privacy-card privacy-visible">
            <h3>Visible to node operators in the network</h3>
            <dl>
              {operatorSees.map(([term, detail]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{detail}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="privacy-side">
            <div class="card privacy-card privacy-hidden">
              <h3>Not visible to them</h3>
              <ul>
                {operatorCannotSee.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="card privacy-card privacy-public">
              <h3>Public by design</h3>
              <p>
                Messages in public community channels are plaintext and searchable, and calls in public communities are
                not end-to-end encrypted. Your public profile (name, username, avatar) is readable by anyone who looks
                it up.
              </p>
            </div>
          </div>
        </div>
        <p class="note">
          Source: the <a href={`${docs}/privacy/DATA-INVENTORY.md`}>current private-data inventory</a>. The
          <a href={`${docs}/privacy/ADR-001-private-data.md`}>private-data architecture decision</a> describes how this
          metadata will be reduced; those protections are not enabled yet.
        </p>
      </section>

      <section id="compare" class="section" aria-labelledby="compare-title">
        <div class="section-heading">
          <h2 id="compare-title">How it compares.</h2>
          <p>A short, honest summary. Pigeon Swarm is younger than all three.</p>
        </div>
        <div class="table-scroll" role="region" aria-labelledby="compare-title" tabindex="0">
          <table>
            <thead>
              <tr>
                <td></td>
                <th scope="col" class="highlight">Pigeon Swarm</th>
                <th scope="col">Discord</th>
                <th scope="col">Matrix</th>
                <th scope="col">Signal</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.values.map((value, index) => <td class={index === 0 ? "highlight" : undefined}>{value}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          Based on each project's public documentation. Details vary by server, client and settings.
        </p>
      </section>

      <section id="validation" class="section" aria-labelledby="validation-title">
        <div class="section-heading">
          <h2 id="validation-title">Tested as a whole, not just in parts.</h2>
          <p>
            The <a href={`${repo}/actions/workflows/validate.yml`}>validation workflow</a> builds the application image
            and runs these acceptance tests against it. They use simulated Docker networks, so they do not prove that every real-world NAT
            or firewall will work.
          </p>
        </div>
        <ul class="validation-grid">
          {validations.map((validation) => (
            <li class="card">
              <h3>{validation.title}</h3>
              <p>{validation.text}</p>
              <a class="text-link" href={validation.href}>Read the test <span aria-hidden="true">↗</span></a>
            </li>
          ))}
        </ul>
      </section>

      <section id="self-host" class="section self-host" aria-labelledby="self-host-title">
        <div class="section-heading">
          <h2 id="self-host-title">Run a node in three commands.</h2>
          <p>
            Docker and Docker Compose are all you need. The bundled TURN server generates and stores its own secret, and
            private-network relays find each other automatically.
          </p>
          <ul class="checks">
            <li>One image for <code>linux/amd64</code> and <code>linux/arm64</code></li>
            <li>Persistent storage in two local folders</li>
            <li>To call or relay over the internet, publish the ports listed in the guide</li>
          </ul>
          <a class="text-link" href={`${docs}/DOCKER_IMAGE.md`}>Deployment guide <span aria-hidden="true">↗</span></a>
        </div>
        <div class="terminal" aria-label="Commands to start a Pigeon Swarm node">
          <pre><code><span class="prompt" aria-hidden="true">$ </span>git clone https://github.com/haskou/pigeon-swarm.git
<span class="prompt" aria-hidden="true">$ </span>cd pigeon-swarm
<span class="prompt" aria-hidden="true">$ </span>docker compose up -d
<span class="comment"># Open http://localhost:8080</span></code></pre>
        </div>
      </section>

      <section id="faq" class="section" aria-labelledby="faq-title">
        <div class="section-heading">
          <h2 id="faq-title">Questions.</h2>
        </div>
        <div class="faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="position" class="section position" aria-labelledby="position-title">
        <h2 id="position-title">No Chat Control. No mandatory scanning. No backdoors.</h2>
        <p>
          Chat Control proposals would require communication services to scan the content of private messages, on a
          server or on your device. Pigeon Swarm opposes message scanning, identity gates and backdoors: private
          correspondence should stay private, and the internet should stay open.
        </p>
        <ul class="inline-links">
          <li><a href="https://eur-lex.europa.eu/eli/treaty/char_2016/art_7/oj/eng">EU Charter, Article 7 ↗</a></li>
          <li><a href="https://eur-lex.europa.eu/eli/treaty/char_2012/art_8/oj/eng">EU Charter, Article 8 ↗</a></li>
          <li><a href="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=COM%3A2022%3A209%3AFIN">COM(2022) 209 ↗</a></li>
        </ul>
      </section>

      <section id="source" class="section" aria-labelledby="source-title">
        <div class="section-heading">
          <h2 id="source-title">Read the code before you trust it.</h2>
          <p>The client, the node and the distribution image are all public.</p>
        </div>
        <ul class="repo-grid">
          <li><a class="card repo" href="https://github.com/haskou/pigeon-swarm-ui"><strong>pigeon-swarm-ui</strong><span>Desktop and mobile client</span></a></li>
          <li><a class="card repo" href="https://github.com/haskou/pigeon-swarm-node"><strong>pigeon-swarm-node</strong><span>Node and network services</span></a></li>
          <li><a class="card repo" href={repo}><strong>pigeon-swarm</strong><span>Docker image, deployment and acceptance tests</span></a></li>
        </ul>
        <p class="note">
          Licensed under <a href={`${repo}/blob/main/LICENSE`}>PolyForm Noncommercial 1.0.0</a>, not an open-source
          license: commercial use requires a separate license from the author.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <p>Pigeon Swarm · Peer-to-peer community chat.</p>
      <p>Not affiliated with Discord Inc., the Matrix.org Foundation or Signal.</p>
    </footer>
  </body>
</html>
