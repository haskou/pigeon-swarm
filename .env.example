PORT=8080
LOG_LEVEL=info
IPFS_STORAGE_HOST_PATH=./ipfs_storage
LOCAL_STORAGE_HOST_PATH=./local_storage
LINK_PREVIEW_RATE_LIMIT_PER_MINUTE=30
PIGEON_RELAY_DATA_LIMIT_BYTES=67108864

# Required private deployment secret; the public fallback is rejected.
# Follow docs/DOCKER_IMAGE.md to generate it directly into .env without printing it.
# Each credential issuer must use the secret of the TURN server it advertises.
CALLS_TURN_SHARED_SECRET=
# Optional explicit IPv4 address or public/private IPv4 mapping for coturn.
CALLS_TURN_EXTERNAL_IP=
# Concurrent allocations per authenticated user and across the server.
CALLS_TURN_USER_QUOTA=16
CALLS_TURN_TOTAL_QUOTA=128
# Optional individual trusted private relay IPv4 addresses, comma-separated.
# Each exception permits all UDP destination ports on that host. See the guide.
CALLS_TURN_ALLOWED_PEER_IPS=
# Optional TLS overlay settings; see docs/DOCKER_IMAGE.md before enabling it.
CALLS_TURN_TLS_PORT=5349
CALLS_TURN_TLS_SERVER_NAME=
CALLS_TURN_TLS_CERTS_DIR=
CALLS_TURN_URLS=
# Docker Compose persists data in host folders by default.

# Optional: fill these with your own generated VAPID values to enable Web Push.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
