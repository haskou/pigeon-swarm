{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "authorization-policy-v1.schema.json",
  "title": "Private scope authorization policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "devices",
    "authorityKeys",
    "threshold",
    "sequencerKey",
    "freshnessAuthorityKey",
    "leaseRevocationKey",
    "leaseRevocationHpkeKey"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceKey",
          "mlsCredentialHash"
        ],
        "properties": {
          "deviceKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          },
          "mlsCredentialHash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          }
        }
      }
    },
    "authorityKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
      }
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "sequencerKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "freshnessAuthorityKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "leaseRevocationKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "leaseRevocationHpkeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  }
}
