{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "outbound-batch-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopeId",
    "revision",
    "headHash",
    "operationHashes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "operationHashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
      }
    }
  }
}
