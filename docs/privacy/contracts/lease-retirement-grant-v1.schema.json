{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lease-retirement-grant-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopeId",
    "revision",
    "headHash",
    "recipientDeviceKey",
    "mailboxId",
    "gatewayOrigin",
    "leaseExpiresAt",
    "retireCapability",
    "issuerDeviceKey",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "recipientDeviceKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "mailboxId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "gatewayOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#]+$",
      "maxLength": 253
    },
    "leaseExpiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retireCapability": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "issuerDeviceKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
